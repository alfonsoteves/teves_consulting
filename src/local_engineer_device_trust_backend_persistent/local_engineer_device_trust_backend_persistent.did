type TrustState = 
 variant {
   paired;
   revoked;
 };
type TrustRecord = 
 record {
   approvingOperatorSessionReference: text;
   deviceId: text;
   firstSeenAtNs: int;
   keyAlgorithm: text;
   keyProtection: KeyProtection;
   keyProtectionTrust: text;
   lastSeenAtNs: int;
   pairedAtNs: int;
   protocolVersion: text;
   publicKeyFingerprint: text;
   publicKeySha256: text;
   publicKeyX963: blob;
   recordVersion: nat;
   revocationReason: opt text;
   revokedAtNs: opt int;
   revokingOperatorSessionReference: opt text;
   schemaVersion: text;
   trustState: TrustState;
 };
type TouchRequest = 
 record {
   deviceId: text;
   expectedRecordVersion: nat;
 };
type State = 
 record {
   authorizationConfigVersion: nat;
   authorizedServicePrincipals: vec principal;
   latestAuthorizationRecovery: opt AuthorizationRecoveryProvenance;
   records: vec TrustRecord;
   recoveryGovernancePrincipals: vec principal;
 };
type RevokeRequest = 
 record {
   deviceId: text;
   revocationReason: opt text;
   revokingOperatorSessionReference: text;
 };
type ReplaceAuthorizedServicePrincipalsRequest = 
 record {
   authorizedServicePrincipals: vec principal;
   expectedAuthorizationConfigVersion: nat;
 };
type RecoveryReasonCode = 
 variant {
   compromised_service_principal;
   lost_service_principal;
   operator_requested;
   other;
   planned_rotation_recovery;
 };
type RecoverAuthorizedServicePrincipalsRequest = 
 record {
   authorizedServicePrincipals: vec principal;
   expectedAuthorizationConfigVersion: nat;
   reasonCode: RecoveryReasonCode;
 };
type RecordResult = 
 variant {
   err: Error;
   ok: TrustRecord;
 };
type PairRequest = 
 record {
   approvingOperatorSessionReference: text;
   deviceId: text;
   expectedRecordVersion: opt nat;
   keyAlgorithm: text;
   keyProtection: KeyProtection;
   keyProtectionTrust: text;
   protocolVersion: text;
   publicKeyFingerprint: text;
   publicKeySha256: text;
   publicKeyX963: blob;
   schemaVersion: text;
 };
type MigrationInstallArgs = record {state: State;};
type LocalEngineerDeviceTrustBackendPersistent = 
 service {
   getLocalEngineerDeviceTrust: (deviceId: text) -> (RecordResult) query;
   getLocalEngineerDeviceTrustAuthorizationConfig: () ->
    (AuthorizationConfigResult) query;
   listLocalEngineerDeviceTrust: (request: ListRequest) -> (ListResult) query;
   pairLocalEngineerDevice: (request: PairRequest) -> (RecordResult);
   readLocalEngineerDeviceTrustAuthoritatively: (deviceId: text) ->
    (RecordResult);
   recoverLocalEngineerDeviceTrustAuthorizedPrincipals: (request:
    RecoverAuthorizedServicePrincipalsRequest) -> (AuthorizationConfigResult);
   replaceLocalEngineerDeviceTrustAuthorizedPrincipals: (request:
    ReplaceAuthorizedServicePrincipalsRequest) -> (AuthorizationResult);
   revokeLocalEngineerDevice: (request: RevokeRequest) -> (RecordResult);
   touchLocalEngineerPairedDevice: (request: TouchRequest) -> (RecordResult);
 };
type ListResult = 
 variant {
   err: Error;
   ok: ListResponse;
 };
type ListResponse = 
 record {
   nextCursor: opt nat;
   records: vec TrustRecord;
 };
type ListRequest = 
 record {
   cursor: opt nat;
   limit: nat;
 };
type KeyProtection = 
 variant {
   keychain_software;
   secure_enclave;
   unknown;
 };
type InstallArgs = 
 variant {
   fresh: InitArgs;
   migration: MigrationInstallArgs;
 };
type InitArgs = 
 record {
   authorizedServicePrincipals: vec principal;
   recoveryGovernancePrincipals: vec principal;
 };
type Error = 
 variant {
   capacity_exceeded;
   invalid_record;
   not_found;
   persistence_failure;
   revoked;
   unauthorized;
   version_conflict;
 };
type AuthorizationResult = 
 variant {
   err: Error;
   ok: vec principal;
 };
type AuthorizationRecoveryProvenance = 
 record {
   authorizationConfigVersion: nat;
   newAuthorizedServicePrincipalsDigest: text;
   previousAuthorizedServicePrincipalsDigest: text;
   reasonCode: RecoveryReasonCode;
   recoveredAtNs: int;
   recoveryCaller: principal;
 };
type AuthorizationConfigResult = 
 variant {
   err: Error;
   ok: AuthorizationConfig;
 };
type AuthorizationConfig = 
 record {
   authorizationConfigVersion: nat;
   authorizedServicePrincipals: vec principal;
   latestAuthorizationRecovery: opt AuthorizationRecoveryProvenance;
   recoveryGovernancePrincipals: vec principal;
 };
service : (init: InstallArgs) -> LocalEngineerDeviceTrustBackendPersistent
