type KeyProtection = variant {
  secure_enclave;
  keychain_software;
  unknown;
};
type TrustState = variant {
  paired;
  revoked;
};
type TrustRecord = record {
  schemaVersion : text;
  protocolVersion : text;
  deviceId : text;
  publicKeyX963 : blob;
  publicKeySha256 : text;
  publicKeyFingerprint : text;
  keyAlgorithm : text;
  keyProtection : KeyProtection;
  keyProtectionTrust : text;
  trustState : TrustState;
  firstSeenAtNs : int;
  pairedAtNs : int;
  lastSeenAtNs : int;
  revokedAtNs : opt int;
  revocationReason : opt text;
  approvingOperatorSessionReference : text;
  revokingOperatorSessionReference : opt text;
  recordVersion : nat;
};
type PairRequest = record {
  schemaVersion : text;
  protocolVersion : text;
  deviceId : text;
  publicKeyX963 : blob;
  publicKeySha256 : text;
  publicKeyFingerprint : text;
  keyAlgorithm : text;
  keyProtection : KeyProtection;
  keyProtectionTrust : text;
  approvingOperatorSessionReference : text;
  expectedRecordVersion : opt nat;
};
type TouchRequest = record {
  deviceId : text;
  expectedRecordVersion : nat;
};
type RevokeRequest = record {
  deviceId : text;
  revocationReason : opt text;
  revokingOperatorSessionReference : text;
};
type ListRequest = record {
  limit : nat;
  cursor : opt nat;
};
type RecoveryReasonCode = variant {
  lost_service_principal;
  compromised_service_principal;
  planned_rotation_recovery;
  operator_requested;
  other;
};
type ReplaceAuthorizedServicePrincipalsRequest = record {
  authorizedServicePrincipals : vec principal;
  expectedAuthorizationConfigVersion : nat;
};
type RecoverAuthorizedServicePrincipalsRequest = record {
  authorizedServicePrincipals : vec principal;
  expectedAuthorizationConfigVersion : nat;
  reasonCode : RecoveryReasonCode;
};
type AuthorizationRecoveryProvenance = record {
  recoveryCaller : principal;
  recoveredAtNs : int;
  previousAuthorizedServicePrincipalsDigest : text;
  newAuthorizedServicePrincipalsDigest : text;
  authorizationConfigVersion : nat;
  reasonCode : RecoveryReasonCode;
};
type AuthorizationConfig = record {
  authorizedServicePrincipals : vec principal;
  recoveryGovernancePrincipals : vec principal;
  authorizationConfigVersion : nat;
  latestAuthorizationRecovery : opt AuthorizationRecoveryProvenance;
};
type Error = variant {
  not_found;
  unauthorized;
  revoked;
  version_conflict;
  invalid_record;
  capacity_exceeded;
  persistence_failure;
};
type RecordResult = variant {
  ok : TrustRecord;
  err : Error;
};
type ListResponse = record {
  records : vec TrustRecord;
  nextCursor : opt nat;
};
type ListResult = variant {
  ok : ListResponse;
  err : Error;
};
type AuthorizationResult = variant {
  ok : vec principal;
  err : Error;
};
type AuthorizationConfigResult = variant {
  ok : AuthorizationConfig;
  err : Error;
};
type InitArgs = record {
  authorizedServicePrincipals : vec principal;
  recoveryGovernancePrincipals : vec principal;
};
service : (InitArgs) -> {
  getLocalEngineerDeviceTrustAuthorizationConfig : () -> (AuthorizationConfigResult) query;
  getLocalEngineerDeviceTrust : (text) -> (RecordResult) query;
  pairLocalEngineerDevice : (PairRequest) -> (RecordResult);
  recoverLocalEngineerDeviceTrustAuthorizedPrincipals : (RecoverAuthorizedServicePrincipalsRequest) -> (AuthorizationConfigResult);
  touchLocalEngineerPairedDevice : (TouchRequest) -> (RecordResult);
  revokeLocalEngineerDevice : (RevokeRequest) -> (RecordResult);
  listLocalEngineerDeviceTrust : (ListRequest) -> (ListResult) query;
  replaceLocalEngineerDeviceTrustAuthorizedPrincipals : (ReplaceAuthorizedServicePrincipalsRequest) -> (AuthorizationResult);
}
